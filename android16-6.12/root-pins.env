# Pinned sources (sourced by build-op15r.yml). All at the upstream branch tips of 2026-11-16.

# SukiSU Ultra ("builtin" branch = the SUSFS-integrated kernel; the project was rebranded SukiSU Nova on
# 2026-11-15, the repository is still SukiSU-Ultra/SukiSU-Ultra). UAPI 6. KSU_VERSION is pinned in the build
# as 30000 + commits(main) - 4001; the matching manager is SukiSU_Nova_v3.0.0_30000 (release v3.0.0).
SUKISU_REPO=https://github.com/SukiSU-Ultra/SukiSU-Ultra.git
SUKISU_PIN=4bec532dd447e2852aa8932afa768255350c103a

# SUSFS (susfs4ksu gki-android16-6.12).
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=gki-android16-6.12
SUSFS_PIN=9b0b13f069673b9b07b713a5c66977de4d62b175

# WildKernels SUSFS helper scripts (context restore, <6.12.92 compat, fanotify arity, ...).
WK_REPO=https://github.com/WildKernels/GKI_KernelSU_SUSFS.git
