# Pinned sources (sourced by build-op15r.yml). All at the upstream branch tips of 2026-11-16.

# KernelSU-Next, pershoot's SUSFS-integrated fork (dev-susfs), the same line WildKernels builds. KSU_VERSION is
# 30000 + commits at its merge-base with upstream KernelSU-Next dev; the matching manager is the KernelSU-Next
# CI build of that merge-base commit (the build log prints it as manager-base).
KSUNEXT_REPO=https://github.com/pershoot/KernelSU-Next.git
KSUNEXT_PIN=4776e7cd67663a532ca49ec9523cc6e9739d6cf2

# SUSFS (susfs4ksu gki-android16-6.12) plus pershoot's two coexistence commits (fs/susfs.c only):
#   6387756d "fs/susfs: Allow core to be built with no features"
#   161c058f "fs/susfs: Implement SuSFS and Toolkit coexistence"
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=gki-android16-6.12
SUSFS_PIN=9b0b13f069673b9b07b713a5c66977de4d62b175
SUSFS_PICKS="6387756d64b3ab9ececefc4523627a9ee05a7519 161c058fed5544a6573d87124f346dadd5c4962d"

# WildKernels SUSFS helper scripts (context restore, <6.12.92 compat, fanotify arity, ...).
WK_REPO=https://github.com/WildKernels/GKI_KernelSU_SUSFS.git
WK_PIN=243bb5a9e72af82251605f1c5c51dab9146a2efd
