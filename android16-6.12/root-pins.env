# Pinned sources for the root implementation + SUSFS (sourced by build-op15r.yml).
# Pairs follow WildKernels/GKI_KernelSU_SUSFS (verified pins, refreshed 2026-11-02/08).

# SukiSU Ultra: "builtin" branch = SUSFS-integrated SukiSU. 1cfa5734 (2026-11-01) is the branch tip;
# its UAPI version (6) matches the SukiSU manager v4.3.0-r2. Paired with SUSFS 68f62fae (v2.3.0).
SUKISU_REPO=https://github.com/SukiSU-Ultra/SukiSU-Ultra.git
SUKISU_PIN=1cfa57340590971cba7521ed536da8ebbedc5f0a
SUKISU_SUSFS_PIN=68f62fae75ada3959f816841a3c64299383521ed

# KernelSU-Next: pershoot "dev-susfs" (SUSFS-integrated Next, what WildKernels builds for SUSFS
# kernels). Paired with SUSFS v2.4.0 + pershoot's two coexistence cherry-picks.
NEXT_REPO=https://github.com/pershoot/KernelSU-Next.git
NEXT_PIN=e1a57f7f7a588e7016b4f2c759b7fdada8d2e4c4
NEXT_SUSFS_PIN=f83ae68add82d1c564e9428ba81dd537fa721924
NEXT_SUSFS_PICKS="6387756d64b3ab9ececefc4523627a9ee05a7519 161c058fed5544a6573d87124f346dadd5c4962d"

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=gki-android16-6.12

# WildKernels SUSFS helper scripts (context restore, <6.12.92 compat, fanotify arity, ...).
